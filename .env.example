# ==============================================================================
# KisanFlow — Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. For Local Development: Copy this file to `.env`. The defaults are configured
#    for local execution with in-memory fallbacks (PostgreSQL and Redis optional).
# 2. For Staging / Production: Set proper production secrets, enforce HTTPS URLs,
#    and set DEMO_MODE=false and NODE_ENV=production.
# ==============================================================================

# ==============================================================================
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ==============================================================================
# Options: development | test | production
NODE_ENV=development

# Server listen port
PORT=3000

# Public-facing application URL
APP_URL=http://localhost:3000

# JWT signing secret (Required for session & booking signature tokens in production)
# In production, use a strong 64-character random string (e.g., openssl rand -base64 48)
JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>

# Allowed CORS origins in production (comma-separated list, e.g., https://kisanflow.gov.in,https://app.kisanflow.in)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo Mode toggle:
# - true: Uses mock authentication, demo seed accounts, and simulated workflows
# - false: Enforces strict production checks, real auth tokens, and strict validation
DEMO_MODE=true

# ==============================================================================
# 2. PERSISTENCE & CACHING LAYER
# ==============================================================================
# PostgreSQL Connection String (Primary Relational Store)
# If PostgreSQL is unavailable during local dev, KisanFlow transparently falls back to synchronized in-memory store.
DATABASE_URL="postgresql://kisanflow_user:kisanflow_secure_password@localhost:5432/kisanflow_db?schema=public"

# Redis Connection URL (Cache, distributed locks, rate-limiting)
# If Redis is unavailable, KisanFlow gracefully continues without crashing.
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# 3. MACHINE LEARNING & COMPUTER VISION SERVICE (FastAPI)
# ==============================================================================
# Self-hosted Python FastAPI microservice for automated crop grading & defect inspection
ML_SERVICE_URL="http://localhost:8000"

# ==============================================================================
# 4. WEATHER FORECASTING ENGINE
# ==============================================================================
# Default provider: open-meteo (zero cost, zero API key required)
WEATHER_PROVIDER="open-meteo"
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_API_KEY=""

# ================================================================
# 5. AI & MULTILINGUAL TRANSLATION ENGINE
# ================================================================
# Default provider: gemini
TRANSLATION_PROVIDER="gemini"
GEMINI_API_KEY=""
BHASHINI_API_KEY=""

# ================================================================
# 6. GOVERNMENT OPEN DATA (Data.gov.in Mandi Prices)
# ================================================================
DATA_GOV_API_URL="https://api.data.gov.in"
DATA_GOV_API_KEY=""
DATA_GOV_MANDI_RESOURCE_ID=""
DATA_GOV_KCC_RESOURCE_ID=""

# ================================================================
# 7. DIRECT BENEFIT TRANSFER (DBT / PFMS) & PAYMENTS
# ================================================================
# Options: simulation | live
# Default is 'simulation' for safe development and staging testing.
DBT_MODE="simulation"
DBT_API_URL=""

# Razorpay Payment Gateway (Test keys for staging, live keys for production)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ================================================================
# 8. DILRMP — OFFICIAL LAND CADASTRAL INTEGRATION (DO NOT CHANGE)
# ================================================================
# Mandatory Indian Government land record standard API endpoint
DILRMP_API_URL="https://api.dilrmp.nic.in/land/v1"

# ================================================================
# 9. COMMUNICATIONS & IDENTITY (OPTIONAL)
# ================================================================
# Firebase Authentication & Push Notifications
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Farmer Communication Channels (SMS / WhatsApp / IVR)
WHATSAPP_API_URL=""
IVR_API_URL=""
SMS_API_URL=""
