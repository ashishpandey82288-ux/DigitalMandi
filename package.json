{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:auth && npm run test:farmer && npm run test:farm && npm run test:farmer-crop && npm run test:crops-msp && npm run test:bookings && npm run test:grading && npm run test:settlements && npm run test:payments && npm run test:transport",
    "test:auth": "tsx scripts/test-auth-rbac.ts",
    "test:farmer": "tsx scripts/test-farmer-profile.ts",
    "test:farm": "tsx scripts/test-farm.ts",
    "test:farmer-crop": "tsx scripts/test-farmer-crop.ts",
    "test:crops-msp": "tsx scripts/test-crops-msp.ts",
    "test:bookings": "tsx scripts/test-bookings.ts",
    "test:grading": "tsx scripts/test-phase3-grading-procurement.ts",
    "test:settlements": "tsx scripts/test-settlements.ts",
    "test:payments": "tsx scripts/test-payments.ts",
    "test:transport": "tsx scripts/test-transport.ts",
    "test:phase7": "tsx scripts/test-phase7-e2e-master.ts",
    "test:concurrency": "tsx scripts/test-concurrency.ts",
    "test:resilience": "tsx scripts/test-production-resilience.ts",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
